# ── Firebase (required) ───────────────────────────────────────────────────────
# Get these from: Firebase Console → Project Settings → General → Your Apps
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ── API server (optional) ─────────────────────────────────────────────────────
# Only needed when deploying the frontend to a static host (e.g. Cloudflare Pages)
# and the API server lives on a different domain (e.g. Railway, Render, Fly.io).
# Leave empty if the API and frontend share the same origin (reverse-proxy setup).
VITE_API_URL=https://api.your-domain.com

# ── Cloudinary (optional — only needed for media uploads) ────────────────────
# Get these from: Cloudinary Console → Dashboard
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
